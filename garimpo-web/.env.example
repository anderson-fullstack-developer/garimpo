# true = dados simulados no navegador; false = backend real
NEXT_PUBLIC_USE_MOCK=true

# Base das chamadas do navegador ao backend (só com NEXT_PUBLIC_USE_MOCK=false).
# "/api" usa o proxy do Next (recomendado: cookies first-party, sem CORS).
NEXT_PUBLIC_API_URL=/api

# Destino do proxy /api -> backend NestJS (lado servidor; não é exposto ao navegador).
API_PROXY_TARGET=http://localhost:3001
