# ---- Ambiente
# development | production | test
ENVIRONMENT=development

# ---- Banco. Local: SQLite (nada para instalar). Produção: a string de conexão da Neon.
# Exemplo Neon: postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
DATABASE_URL=sqlite:///./garimpo.db

# ---- Sessão (gere um valor longo e aleatório em produção: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=troque-isto-em-producao
# true em produção (HTTPS)
COOKIE_SECURE=false
# ex.: .seudominio.com em produção (vazio = padrão)
COOKIE_DOMAIN=

# ---- Site (para links de e-mail e CORS)
WEB_URL=http://localhost:3200
CORS_ORIGINS=["http://localhost:3200"]
# true atrás do proxy do Next/Railway (usa X-Forwarded-For)
TRUST_PROXY=false

# ---- Cadastro
# OPEN (qualquer pessoa cria conta) | APPROVAL (você aprova cada uma)
REGISTRATION_MODE=OPEN
REQUIRE_VERIFICATION=true
# enquanto não houver cobrança, todos entram como PRO (limites maiores)
DEFAULT_PLAN=PRO
# vazio = sem captcha
TURNSTILE_SECRET=

# ---- E-mail (vazio = os e-mails aparecem no console do servidor)

# ---- Telegram (bot central)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=GarimpoAlertasBot
TELEGRAM_WEBHOOK_SECRET=

# ---- Vinted e monitor
# live = site de verdade; fake = anúncios de mentira (desenvolvimento sem internet)
VINTED_SOURCE=live
# segundos mínimos entre duas requisições à Vinted (seja educado: evita bloqueio)
VINTED_MIN_INTERVAL_SECONDS=1.5
# liga o monitor em segundo plano ao iniciar o servidor
MONITOR_AUTOSTART=true
# de quantos em quantos segundos o monitor procura usuários com ciclo vencido
MONITOR_TICK_SECONDS=20
# traduz os títulos para português nos avisos (MyMemory, grátis)
TRANSLATE_ENABLED=true
# consulta o câmbio do BCE (Frankfurter) para comparar preços em euro
LIVE_EXCHANGE_RATES=true
# dias sem ver um anúncio até apagá-lo do banco (junto com casamentos e avisos dele)
RETENTION_DAYS=30
# espera do servidor quando NINGUÉM está com o monitor ligado (deixa a Neon dormir)
MONITOR_IDLE_SECONDS=240
# máximo de anúncios por mensagem do Telegram (o resto fica em Resultados)
MAX_ITEMS_PER_MESSAGE=15


# Stripe (assinatura Garimpo Pro, EUR 9/mes). Use chaves de TESTE (sk_test_...) enquanto desenvolve.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=7
